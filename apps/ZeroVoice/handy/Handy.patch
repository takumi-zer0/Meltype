index 0000000..3ae2329
--- /dev/null
+++ b/src-tauri/src/correction.rs
@@ -0,0 +1,453 @@
+//! Local, reviewed correction. No HTTP listener, shell, transcript log or history.
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::fs::File;
+use std::io::{BufRead, BufReader, Read, Write};
+use std::path::{Component, Path, PathBuf};
+use std::process::{Child, ChildStdin, Command, Stdio};
+use std::sync::{mpsc, Mutex};
+use std::time::Duration;
+use tauri::{AppHandle, Emitter, Manager};
+use tauri_plugin_clipboard_manager::ClipboardExt;
+
+const UNAVAILABLE: &str = "correction.unavailable";
+const STALE: &str = "correction.stale";
+
+struct Pipe {
+    child: Child,
+    input: ChildStdin,
+    output: mpsc::Receiver<Value>,
+    _verified: Vec<File>,
+}
+
+#[derive(Deserialize)]
+struct VerifiedFile {
+    path: String,
+    sha256: String,
+}
+
+fn verify(root: &Path, manifest: &str) -> Result<Vec<File>, String> {
+    let entries: Vec<VerifiedFile> =
+        serde_json::from_reader(File::open(root.join(manifest)).map_err(|_| UNAVAILABLE)?)
+            .map_err(|_| UNAVAILABLE)?;
+    if entries.is_empty() || entries.len() > 512 {
+        return Err(UNAVAILABLE.into());
+    }
+    entries
+        .into_iter()
+        .map(|entry| {
+            let relative = Path::new(&entry.path);
+            if relative
+                .components()
+                .any(|c| !matches!(c, Component::Normal(_)))
+            {
+                return Err(UNAVAILABLE.into());
+            }
+            let mut options = std::fs::OpenOptions::new();
+            options.read(true);
+            #[cfg(windows)]
+            {
+                use std::os::windows::fs::OpenOptionsExt;
+                options.share_mode(1); // Deny changes while the helper is alive.
+            }
+            let mut file = options.open(root.join(relative)).map_err(|_| UNAVAILABLE)?;
+            let mut hash = Sha256::new();
+            let mut bytes = [0u8; 65536];
+            loop {
+                let count = file.read(&mut bytes).map_err(|_| UNAVAILABLE)?;
+                if count == 0 {
+                    break;
+                }
+                hash.update(&bytes[..count]);
+            }
+            if !format!("{:x}", hash.finalize()).eq_ignore_ascii_case(&entry.sha256) {
+                return Err(UNAVAILABLE.into());
+            }
+            Ok(file)
+        })
+        .collect()
+}
+
+impl Pipe {
+    fn start(root: &Path, executable: &str, args: &[&str]) -> Result<Self, String> {
+        let verified = verify(root, "files.json")?;
+        let mut command = Command::new(root.join(executable));
+        command
+            .args(args)
+            .current_dir(root)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null());
+        #[cfg(windows)]
+        {
+            use std::os::windows::process::CommandExt;
+            command.creation_flags(0x08000000);
+        }
+        let mut child = command.spawn().map_err(|_| UNAVAILABLE)?;
+        let input = child.stdin.take().ok_or(UNAVAILABLE)?;
+        let output = child.stdout.take().ok_or(UNAVAILABLE)?;
+        let (tx, rx) = mpsc::sync_channel(1);
+        std::thread::spawn(move || {
+            let mut reader = BufReader::new(output);
+            loop {
+                let mut line = Vec::new();
+                // take() prevents allocation of an unbounded child response.
+                let read = (&mut reader).take(65537).read_until(b'\n', &mut line);
+                if !matches!(read, Ok(1..=65536)) || line.last() != Some(&b'\n') {
+                    break;
+                }
+                let Ok(value) = serde_json::from_slice(&line) else {
+                    break;
+                };
+                if tx.send(value).is_err() {
+                    break;
+                }
+            }
+        });
+        Ok(Self {
+            child,
+            input,
+            output: rx,
+            _verified: verified,
+        })
+    }
+    fn read(&self, seconds: u64) -> Result<Value, String> {
+        self.output
+            .recv_timeout(Duration::from_secs(seconds))
+            .map_err(|_| UNAVAILABLE.into())
+    }
+    fn request(&mut self, request: Value, seconds: u64) -> Result<Value, String> {
+        let mut bytes = serde_json::to_vec(&request).map_err(|_| UNAVAILABLE)?;
+        if bytes.len() > 64000 {
+            return Err(UNAVAILABLE.into());
+        }
+        bytes.push(b'\n');
+        self.input
+            .write_all(&bytes)
+            .and_then(|_| self.input.flush())
+            .map_err(|_| UNAVAILABLE)?;
+        self.read(seconds)
+    }
+}
+impl Drop for Pipe {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+#[derive(Clone, Default, Serialize, Deserialize, specta::Type)]
+#[serde(rename_all = "camelCase")]
+pub struct Review {
+    id: u32,
+    original: String,
+    context: String,
+    text: String,
+    warnings: Vec<String>,
+    busy: bool,
+    rejected: bool,
+    can_paste: bool,
+    elapsed_ms: u32,
+}
+#[derive(Default)]
+struct Session {
+    id: u32,
+    review: Option<Review>,
+    native: Option<Pipe>,
+    context: String,
+    token: String,
+}
+pub struct CorrectionManager {
+    root: PathBuf,
+    session: Mutex<Session>,
+    worker: Mutex<Option<Pipe>>,
+}
+impl CorrectionManager {
+    pub fn new(app: &AppHandle) -> Self {
+        Self {
+            root: app
+                .path()
+                .resource_dir()
+                .unwrap_or_default()
+                .join("resources/zerovoice"),
+            session: Mutex::new(Session::default()),
+            worker: Mutex::new(None),
+        }
+    }
+    fn worker(&self) -> Result<std::sync::MutexGuard<'_, Option<Pipe>>, String> {
+        let mut guard = self.worker.lock().map_err(|_| UNAVAILABLE)?;
+        if guard.is_none() {
+            let executable = if cfg!(windows) {
+                "ZeroVoice.Worker.exe"
+            } else {
+                "ZeroVoice.Worker"
+            };
+            let pipe = Pipe::start(&self.root, executable, &["--stdio"])?;
+            if pipe.read(90)?.get("ready") != Some(&json!(true)) {
+                return Err(UNAVAILABLE.into());
+            }
+            *guard = Some(pipe);
+        }
+        Ok(guard)
+    }
+    pub fn warm(&self) {
+        drop(self.worker());
+    }
+    // Capture before any Handy window steals focus. Failed capture permits copy only.
+    pub fn capture(&self) {
+        if let Ok(mut session) = self.session.lock() {
+            session.id = session.id.wrapping_add(1);
+            session.review = None;
+            session.native = None;
+            session.context.clear();
+            session.token.clear();
+            let name = if cfg!(windows) {
+                "ZeroVoice.Windows.exe"
+            } else {
+                "ZeroVoice.Mac"
+            };
+            if let Ok(mut pipe) = Pipe::start(&self.root.join("native"), name, &[]) {
+                if let Ok(reply) = pipe.request(json!({"operation":"capture"}), 4) {
+                    if reply["target"]["available"].as_bool() == Some(true) {
+                        session.context =
+                            reply["target"]["context"].as_str().unwrap_or("").to_owned();
+                        session.token = reply["target"]["token"].as_str().unwrap_or("").to_owned();
+                        session.native = Some(pipe);
+                    }
+                }
+            }
+        }
+    }
+    fn begin(&self, original: String) -> Result<Review, String> {
+        let mut session = self.session.lock().map_err(|_| UNAVAILABLE)?;
+        validate_text(&original, 6000)?;
+        let review = Review {
+            id: session.id,
+            original: original.clone(),
+            text: original,
+            context: session.context.clone(),
+            can_paste: session.native.is_some(),
+            busy: true,
+            ..Default::default()
+        };
+        session.review = Some(review.clone());
+        Ok(review)
+    }
+    fn infer(&self, mut review: Review) -> Result<Review, String> {
+        let result = (|| {
+            let mut worker = self.worker()?;
+            let response = worker.as_mut().ok_or(UNAVAILABLE)?.request(
+                json!({"id":review.id,"operation":"correct","text":review.original,"context":review.context}), 40);
+            if response.is_err() {
+                *worker = None;
+            }
+            response
+        })();
+        review.busy = false;
+        match result {
+            Ok(value) if value["id"].as_u64() == Some(u64::from(review.id)) => {
+                let value = &value["result"];
+                review.text = value["text"]
+                    .as_str()
+                    .unwrap_or(&review.original)
+                    .to_owned();
+                validate_text(&review.text, 6000)?;
+                review.rejected = value["rejected"].as_bool().unwrap_or(true);
+                review.warnings =
+                    serde_json::from_value(value["warnings"].clone()).unwrap_or_default();
+                review.elapsed_ms = value["elapsedMs"]
+                    .as_u64()
+                    .unwrap_or(0)
+                    .min(u64::from(u32::MAX)) as u32;
+            }
+            _ => {
+                review.rejected = true;
+                review.warnings = vec![UNAVAILABLE.into()];
+            }
+        }
+        let mut session = self.session.lock().map_err(|_| UNAVAILABLE)?;
+        if session.id != review.id || session.review.is_none() {
+            return Err(STALE.into());
+        }
+        session.review = Some(review.clone());
+        Ok(review)
+    }
+}
+fn validate_text(text: &str, limit: usize) -> Result<(), String> {
+    if text.trim().is_empty()
+        || text.encode_utf16().count() > limit
+        || text.chars().any(|c| {
+            (c.is_control() && !matches!(c, '\r' | '\n' | '\t'))
+                || matches!(c, '\u{202a}'..='\u{202e}' | '\u{2066}'..='\u{2069}')
+        })
+    {
+        Err("correction.invalid".into())
+    } else {
+        Ok(())
+    }
+}
+
+pub async fn review_transcript(app: AppHandle, text: String) {
+    let Ok(review) = app.state::<CorrectionManager>().begin(text) else {
+        return;
+    };
+    let _ = app.emit("correction-review", &review);
+    crate::show_main_window(&app);
+    let cloned = app.clone();
+    let result = tauri::async_runtime::spawn_blocking(move || {
+        cloned.state::<CorrectionManager>().infer(review)
+    })
+    .await;
+    if let Ok(Ok(review)) = result {
+        let _ = app.emit("correction-review", review);
+    }
+}
+
+#[tauri::command]
+#[specta::specta]
+pub fn correction_pending(app: AppHandle) -> Result<Option<Review>, String> {
+    Ok(app
+        .state::<CorrectionManager>()
+        .session
+        .lock()
+        .map_err(|_| UNAVAILABLE)?
+        .review
+        .clone())
+}
+
+#[tauri::command]
+#[specta::specta]
+pub async fn correction_retry(
+    app: AppHandle,
+    id: u32,
+    original: String,
+    context: String,
+) -> Result<Review, String> {
+    validate_text(&original, 6000)?;
+    if !context.is_empty() {
+        validate_text(&context, 1200)?;
+    }
+    let review = {
+        let manager = app.state::<CorrectionManager>();
+        let mut session = manager.session.lock().map_err(|_| UNAVAILABLE)?;
+        let prior = session.review.as_ref().ok_or(STALE)?;
+        if session.id != id || prior.busy {
+            return Err(STALE.into());
+        }
+        session.id = session.id.wrapping_add(1);
+        let review = Review {
+            id: session.id,
+            text: original.clone(),
+            original,
+            context,
+            can_paste: session.native.is_some(),
+            busy: true,
+            ..Default::default()
+        };
+        session.review = Some(review.clone());
+        review
+    };
+    let _ = app.emit("correction-review", &review);
+    let cloned = app.clone();
+    let result = tauri::async_runtime::spawn_blocking(move || {
+        cloned.state::<CorrectionManager>().infer(review)
+    })
+    .await
+    .map_err(|_| UNAVAILABLE)??;
+    let _ = app.emit("correction-review", &result);
+    Ok(result)
+}
+
+#[tauri::command]
+#[specta::specta]
+pub async fn correction_apply(
+    app: AppHandle,
+    id: u32,
+    text: String,
+    approved: bool,
+    paste: bool,
+) -> Result<(), String> {
+    validate_text(&text, 6000)?;
+    tauri::async_runtime::spawn_blocking(move || {
+        let manager = app.state::<CorrectionManager>();
+        let mut session = manager.session.lock().map_err(|_| UNAVAILABLE)?;
+        let review = session.review.as_ref().ok_or(STALE)?;
+        if !approved || review.busy || session.id != id {
+            return Err(STALE.into());
+        }
+        // Manual editing is explicit. Never send Enter, even if Handy auto-submit is enabled.
+        if paste {
+            let token = session.token.clone();
+            let mut pipe = session.native.take().ok_or("correction.copyOnly")?;
+            if let Some(review) = session.review.as_mut() {
+                review.can_paste = false;
+            }
+            let reply = pipe.request(json!({"operation":"paste","token":token,"text":text}), 4)?;
+            if reply["ok"].as_bool() != Some(true) {
+                return Err("correction.copyOnly".into());
+            }
+        } else {
+            app.clipboard()
+                .write_text(text)
+                .map_err(|_| "correction.copyOnly")?;
+        }
+        session.review = None;
+        session.native = None;
+        session.context.clear();
+        session.token.clear();
+        Ok(())
+    })
+    .await
+    .map_err(|_| UNAVAILABLE)?
+}
+
+#[tauri::command]
+#[specta::specta]
+pub fn correction_discard(app: AppHandle, id: u32) -> Result<(), String> {
+    let manager = app.state::<CorrectionManager>();
+    let mut session = manager.session.lock().map_err(|_| UNAVAILABLE)?;
+    if session.id != id {
+        return Err(STALE.into());
+    }
+    session.id = session.id.wrapping_add(1);
+    session.review = None;
+    session.native = None;
+    session.context.clear();
+    session.token.clear();
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn input_bounds_and_controls() {
+        assert!(validate_text("仕様を確認してください。", 6000).is_ok());
+        assert!(validate_text("\u{202e}秘密", 6000).is_err());
+        assert!(validate_text(&"あ".repeat(6001), 6000).is_err());
+        assert!(validate_text(" \n", 6000).is_err());
+    }
+    #[test]
+    fn stale_result_cannot_replace_new_recording() {
+        let manager = CorrectionManager {
+            root: PathBuf::new(),
+            session: Mutex::new(Session::default()),
+            worker: Mutex::new(None),
+        };
+        let review = manager.begin("元の文".into()).expect("fixture");
+        manager.session.lock().expect("fixture").id += 1;
+        assert!(manager.infer(review).is_err());
+        assert_eq!(
+            manager
+                .session
+                .lock()
+                .expect("fixture")
+                .review
+                .as_ref()
+                .expect("fixture")
+                .original,
+            "元の文"
+        );
+    }
+}
