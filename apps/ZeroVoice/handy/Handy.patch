+import React from "react";
+import ReactDOM from "react-dom/client";
+import i18n from "i18next";
+import { initReactI18next } from "react-i18next";
+import ja from "../src/i18n/locales/ja/translation.json";
+import { CorrectionReview } from "../src/components/CorrectionReview";
+import "../src/App.css";
+
+const calls: { command: string; args: Record<string, unknown> }[] = [];
+const fixture = {
+  id: 1, original: "えーと、この変更を本番に反映する前に既存の機能影響がないか確認してもらえますか。",
+  context: "リリース前の影響調査を依頼しています。",
+  text: "この変更を本番に反映する前に、既存の機能に影響がないか確認してもらえますか。",
+  warnings: [], busy: false, rejected: false, canPaste: true, elapsedMs: 2100,
+};
+Object.assign(window, {
+  testCalls: calls,
+  __TAURI_INTERNALS__: {
+    transformCallback: () => 1,
+    invoke: async (command: string, args: Record<string, unknown>) => {
+      calls.push({ command, args });
+      if (command === "correction_pending") return fixture;
+      return 1;
+    },
+  },
+  __TAURI_EVENT_PLUGIN_INTERNALS__: { unregisterListener: () => {} },
+});
+void i18n.use(initReactI18next).init({ lng: "ja", resources: { ja: { translation: ja } } }).then(() => {
+  const root = document.getElementById("root");
+  if (root) ReactDOM.createRoot(root).render(<CorrectionReview />);
+});
