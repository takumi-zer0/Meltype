diff --git a/src/components/CorrectionReview.tsx b/src/components/CorrectionReview.tsx
new file mode 100644
index 0000000..3d8afd3
--- /dev/null
+++ b/src/components/CorrectionReview.tsx
@@ -0,0 +1,218 @@
+import { useEffect, useState } from "react";
+import { invoke } from "@tauri-apps/api/core";
+import { listen } from "@tauri-apps/api/event";
+import { useTranslation } from "react-i18next";
+
+interface Review {
+  id: number;
+  original: string;
+  context: string;
+  text: string;
+  warnings: string[];
+  busy: boolean;
+  rejected: boolean;
+  canPaste: boolean;
+  elapsedMs: number;
+}
+
+export function CorrectionReview() {
+  const { t } = useTranslation();
+  const [review, setReview] = useState<Review | null>(null);
+  const [original, setOriginal] = useState("");
+  const [context, setContext] = useState("");
+  const [text, setText] = useState("");
+  const [approved, setApproved] = useState(false);
+  const [working, setWorking] = useState(false);
+  const [error, setError] = useState("");
+  useEffect(() => {
+    let disposed = false;
+    const receive = (value: Review | null) => {
+      if (disposed) return;
+      setReview(value);
+      setOriginal(value?.original ?? "");
+      setContext(value?.context ?? "");
+      setText(value?.text ?? "");
+      setApproved(false);
+      setError("");
+    };
+    const subscription = listen<Review>("correction-review", ({ payload }) =>
+      receive(payload),
+    );
+    void subscription
+      .then(() => invoke<Review | null>("correction_pending").then(receive))
+      .catch(() => {});
+    return () => {
+      disposed = true;
+      void subscription.then((unlisten) => unlisten());
+    };
+  }, []);
+  if (!review) return null;
+  const busy = review.busy || working;
+  const dirty = original !== review.original || context !== review.context;
+  const fail = (reason: unknown) => {
+    const key =
+      typeof reason === "string" && reason.startsWith("correction.")
+        ? reason
+        : "correction.unavailable";
+    setError(t(key));
+    setApproved(false);
+  };
+  const apply = async (paste: boolean) => {
+    setWorking(true);
+    try {
+      await invoke("correction_apply", {
+        id: review.id,
+        text,
+        approved,
+        paste,
+      });
+      setReview(null);
+    } catch (reason) {
+      fail(reason);
+    } finally {
+      setWorking(false);
+    }
+  };
+  const retry = async () => {
+    setWorking(true);
+    setApproved(false);
+    setError("");
+    try {
+      await invoke("correction_retry", { id: review.id, original, context });
+    } catch (reason) {
+      fail(reason);
+    } finally {
+      setWorking(false);
+    }
+  };
+  const discard = async () => {
+    try {
+      await invoke("correction_discard", { id: review.id });
+      setReview(null);
+    } catch (reason) {
+      fail(reason);
+    }
+  };
+  return (
+    <div
+      role="dialog"
+      aria-modal="true"
+      aria-labelledby="correction-title"
+      className="fixed inset-0 z-[100] bg-background text-text overflow-y-auto p-5"
+    >
+      <div className="max-w-3xl mx-auto flex flex-col gap-3">
+        <h1 id="correction-title" className="text-xl font-semibold">
+          {t("correction.title")}
+        </h1>
+        <p className="text-sm opacity-75">{t("correction.description")}</p>
+        <label className="flex flex-col gap-1 text-sm">
+          {t("correction.original")}
+          <textarea
+            value={original}
+            disabled={busy}
+            maxLength={6000}
+            rows={2}
+            className="border rounded p-2 bg-background"
+            onChange={(e) => {
+              setOriginal(e.target.value);
+              setApproved(false);
+            }}
+          />
+        </label>
+        <label className="flex flex-col gap-1 text-sm">
+          {t("correction.context")}
+          <textarea
+            value={context}
+            disabled={busy}
+            maxLength={1200}
+            rows={2}
+            className="border rounded p-2 bg-background"
+            onChange={(e) => {
+              setContext(e.target.value);
+              setApproved(false);
+            }}
+          />
+        </label>
+        <button
+          disabled={busy || !original.trim()}
+          onClick={() => void retry()}
+          className="border rounded p-2 disabled:opacity-40"
+        >
+          {t("correction.retry")}
+        </button>
+        <label className="flex flex-col gap-1 text-sm">
+          {t("correction.result")}
+          <textarea
+            value={text}
+            disabled={busy || dirty}
+            maxLength={6000}
+            rows={3}
+            className="border rounded p-2 bg-background"
+            onChange={(e) => {
+              setText(e.target.value);
+              setApproved(false);
+            }}
+          />
+        </label>
+        <p role="status" className="text-sm">
+          {busy
+            ? t("correction.processing")
+            : t("correction.elapsed", {
+                seconds: (review.elapsedMs / 1000).toFixed(1),
+              })}
+        </p>
+        {review.rejected && (
+          <p className="text-sm">{t("correction.rejected")}</p>
+        )}
+        {review.warnings.map((warning, index) => (
+          <p className="text-sm" key={index}>
+            {warning.startsWith("correction.") ? t(warning) : warning}
+          </p>
+        ))}
+        {!review.canPaste && (
+          <p className="text-sm">{t("correction.copyOnly")}</p>
+        )}
+        {dirty && <p className="text-sm">{t("correction.dirty")}</p>}
+        {error && (
+          <p role="alert" className="text-sm text-red-500">
+            {error}
+          </p>
+        )}
+        <label className="flex gap-2 text-sm items-center">
+          <input
+            type="checkbox"
+            checked={approved}
+            disabled={busy || dirty}
+            onChange={(e) => setApproved(e.target.checked)}
+          />
+          {t("correction.approve")}
+        </label>
+        <div className="flex gap-2 pb-4">
+          <button
+            onClick={() => void apply(true)}
+            disabled={
+              busy || dirty || !approved || !text.trim() || !review.canPaste
+            }
+            className="border rounded p-2 disabled:opacity-40"
+          >
+            {t("correction.paste")}
+          </button>
+          <button
+            onClick={() => void apply(false)}
+            disabled={busy || dirty || !approved || !text.trim()}
+            className="border rounded p-2 disabled:opacity-40"
+          >
+            {t("correction.copy")}
+          </button>
+          <button
+            onClick={() => void discard()}
+            disabled={working}
+            className="border rounded p-2 disabled:opacity-40"
+          >
+            {t("correction.discard")}
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
