@@ -0,0 +1,28 @@
+import { test, expect } from "@playwright/test";
+
+test("approval resets on edits and context changes block insertion", async ({ page }) => {
+  await page.goto("/tests/correction.html");
+  const paste = page.getByRole("button", { name: "元の入力欄に入力" });
+  const approve = page.getByRole("checkbox");
+  await expect(paste).toBeDisabled();
+  await approve.check();
+  await expect(paste).toBeEnabled();
+  await page.getByLabel("入力する文章（編集できます）").fill("手動で確認した文章です。");
+  await expect(approve).not.toBeChecked();
+  await expect(paste).toBeDisabled();
+  await approve.check();
+  await page.getByLabel("周辺の文脈（任意）").fill("変更した文脈です。");
+  await expect(approve).toBeDisabled();
+  await expect(paste).toBeDisabled();
+});
+
+test("copy sends only the explicitly reviewed text once", async ({ page }) => {
+  await page.goto("/tests/correction.html");
+  const text = "手動で確認した文章です。";
+  await page.getByLabel("入力する文章（編集できます）").fill(text);
+  await page.getByRole("checkbox").check();
+  await page.getByRole("button", { name: "コピー", exact: true }).click();
+  await expect(page.getByRole("dialog")).toHaveCount(0);
+  const calls = await page.evaluate(() => (window as unknown as { testCalls: {command: string; args: unknown}[] }).testCalls.filter(c => c.command === "correction_apply"));
+  expect(calls).toEqual([{ command: "correction_apply", args: { id: 1, text, approved: true, paste: false } }]);
+});
